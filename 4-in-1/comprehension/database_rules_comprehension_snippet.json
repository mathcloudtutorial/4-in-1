"comprehension": {
  ".read": true,
  ".write": true,
  "passages": {
    ".indexOn": ["classId", "studentId"]
  },
  "sessions": {
    ".indexOn": ["studentId", "completedAt"],
    "$id": {
      ".validate": "newData.hasChildren(['studentId','score','total','correct','completedAt']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 100 && newData.child('total').val() > 0 && newData.child('correct').val() <= newData.child('total').val()"
    }
  }
}
